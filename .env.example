# Copy to .env for local development. Never commit a filled-in copy.

# --- Database -------------------------------------------------------------
ECONIQ_DB_URL=postgresql+psycopg://econiq:econiq@localhost:5432/econiq
ECONIQ_DB_ECHO=false

# Host ports for the compose stack. Override when something already owns the
# default (a system Postgres on 5432 is the usual culprit).
# ECONIQ_POSTGRES_PORT=55432
# ECONIQ_MINIO_PORT=9000
# ECONIQ_MINIO_CONSOLE_PORT=9001
# ECONIQ_REDIS_PORT=6379

# --- Object storage (MinIO locally, S3 in AWS) ----------------------------
ECONIQ_S3_ENDPOINT_URL=http://localhost:9000
ECONIQ_S3_ACCESS_KEY_ID=econiq
ECONIQ_S3_SECRET_ACCESS_KEY=econiq-dev-secret
ECONIQ_S3_BUCKET=econiq-documents

# --- Cache / queue --------------------------------------------------------
ECONIQ_REDIS_URL=redis://localhost:6379/0

# --- LLM ------------------------------------------------------------------
ECONIQ_LLM_PROVIDER=anthropic
ECONIQ_LLM_ANTHROPIC_API_KEY=
# Model tiering per agent. Revisit as an evaluation question, not a code change.
ECONIQ_LLM_REASONING_MODEL=claude-opus-5
ECONIQ_LLM_STANDARD_MODEL=claude-sonnet-5
ECONIQ_LLM_FAST_MODEL=claude-haiku-4-5
ECONIQ_LLM_DEFAULT_EFFORT=high
ECONIQ_LLM_MAX_ATTEMPTS=3
